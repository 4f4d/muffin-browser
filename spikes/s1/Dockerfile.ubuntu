FROM rust:1.95-slim-bookworm AS toolchain
FROM ubuntu:24.04
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH
COPY --from=toolchain /usr/local/rustup /usr/local/rustup
COPY --from=toolchain /usr/local/cargo/bin /usr/local/cargo/bin
RUN apt-get -o Acquire::Retries=1 -o Acquire::http::Timeout=30 update \
    && apt-get -o Acquire::Retries=1 -o Acquire::http::Timeout=30 install -y --no-install-recommends \
        ca-certificates gcc libwebkit2gtk-4.1-dev xvfb xauth x11-utils imagemagick python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /fixture
COPY s1 /fixture/spikes/s1
COPY engine-floor/linux/run.sh /fixture/spikes/engine-floor/linux/run.sh
RUN cargo build --locked --manifest-path spikes/s1/wry-tao/Cargo.toml \
    --target-dir /fixture-target
RUN getent passwd 1000 || useradd --create-home --uid 1000 muffin
USER 1000:1000
