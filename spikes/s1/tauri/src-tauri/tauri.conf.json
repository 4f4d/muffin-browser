{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muffin S1 Tauri",
  "version": "0.1.0",
  "identifier": "local.muffin.s1.tauri",
  "build": {
    "frontendDist": "../assets"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Muffin S1 Tauri",
        "width": 900,
        "height": 620,
        "minWidth": 720,
        "minHeight": 520,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:*; font-src 'self';"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
